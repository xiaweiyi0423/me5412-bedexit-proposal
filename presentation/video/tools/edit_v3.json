 "scenes": [
  {"id": "S1", "file": "ai/variants/S1_alt_t1.mp4", "dur": 4.0, "tag": "AI 生成动画（概念示意）", "narr": "audio/N1.wav", "narr_at": 1.0, "sub": "凌晨三点。",
   "sfx": [{"file": "audio/sfx_tick.wav", "at": 0.0, "dur": 4.0, "db": -14}]},
  {"id": "KD", "file": "comic/KD.mp4", "dur": 5.0, "tag": "AI 生成动画（概念示意）", "narr": "audio/N1b.wav", "narr_at": 0.0, "sub": "许多年前，她在雪地里，扶起过一只受伤的鹤；",
   "sfx": [{"file": "audio/sfx_tick.wav", "at": 0.0, "dur": 2.6, "db": -13}]},
  {"id": "S2", "file": "ai/S2.mp4", "start": 0.2, "dur": 6.8, "tag": "AI 生成动画（概念示意）", "narr": "audio/N2.wav", "narr_at": 1.3, "sub": "如今，从床沿到站直，成了夜里最难的一段路。"},
  {"id": "S3", "file": "gfx/S3.mp4", "dur": 3.0, "transition": "fadeblack"},
  {"id": "S4", "file": "3d/S4_noborder.mp4", "dur": 3.5, "tag": "按设计尺寸的三维模型", "narr": "audio/N4.wav", "narr_at": 0.3, "sub": "平时，它和床一样低，安安静静。"},
