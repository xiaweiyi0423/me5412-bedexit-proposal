   "sfx": [{"file": "audio/sfx_paper.wav", "at": 0.8, "db": -6}, {"file": "audio/sfx_chime.wav", "at": 4.85, "db": -8}, {"file": "audio/sfx_paper.wav", "at": 6.2, "dur": 1.6, "db": -8}]},
  {"id": "K5", "file": "comic/K5.mp4", "dur": 4.0, "tag": "AI 生成动画（概念示意）", "narr": "audio/N5.wav", "narr_at": 0.8, "sub": "往前挪一点，就坐上了。"},
  {"id": "K6", "file": "comic/K6.mp4", "dur": 3.5, "tag": "AI 生成动画（概念示意）", "narr": "audio/N6.wav", "narr_at": 0.3, "sub": "握住横杆，按住开关。",
   "sfx": [{"file": "audio/sfx_click.wav", "at": 1.15, "db": -6}]},
  {"id": "K78", "file": "comic/K78.mp4", "dur": 11.0, "tag": "AI 生成动画（概念示意）",
   "narr": "audio/N7.wav", "narr_at": 0.7, "sub": "它像一位老朋友，慢慢扬起脖颈——",
   "narr2": "audio/N8.wav", "narr2_at": 5.0, "sub2": "她快一点，它就快一点；她慢下来，它也跟着慢。",
   "sfx": [{"file": "audio/sfx_hum.wav", "at": 1.5, "dur": 6.0, "db": -18}]},
  {"id": "K9", "file": "comic/K9.mp4", "dur": 5.5, "tag": "AI 生成动画（概念示意）", "narr": "audio/N9.wav", "narr_at": 0.2, "sub": "一松手，就稳稳停住；坐回去，也有它接着。",
   "sfx": [{"file": "audio/sfx_lock.wav", "at": 1.1, "db": -8}]},
